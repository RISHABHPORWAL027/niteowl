rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection:
    // Anyone can create an order; order owner and admins can read/update
    match /orders/{orderId} {
      allow read, create: if true;
      allow update: if true; // In production, add auth verification: request.auth != null
    }

    // Outlets & Cloud Kitchens:
    // Diners can view outlet info; hub managers and admins can toggle status
    match /outlets/{outletId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Concentric Delivery Zones:
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fleet & Delivery Pilots:
    match /riders/{riderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Midnight Menu:
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
